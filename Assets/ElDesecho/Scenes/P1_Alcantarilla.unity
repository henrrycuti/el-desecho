  m_Script: {fileID: 11500000, guid: a8e377a532fa1954f885476f78f5389a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ElDesecho.ObjectiveManager
  steps:
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: marcas
    lines:
    - El GPS marca una ruta bajo las calles. Termina en una puerta de seguridad.
    - El agua le llega a los tobillos.
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 1482370023}
    - {fileID: 1325782878}
    - {fileID: 518257020}
    - {fileID: 723394780}
    - {fileID: 1206518888}
    - {fileID: 1432390385}
    - {fileID: 1680485464}
    - {fileID: 880479334}
    gpsSignal: 0.9
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 1
    checkpointSpawn: escalera
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: camara
    lines:
    - Marcas recientes en el suelo... como si algo pesado hubiera sido arrastrado por aqui.
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 1325782878}
    - {fileID: 518257020}
    - {fileID: 723394780}
    - {fileID: 1206518888}
    - {fileID: 1432390385}
    - {fileID: 1680485464}
    - {fileID: 880479334}
    gpsSignal: 0.55
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 0
    checkpointSpawn: 
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: puerta-vista
    lines:
    - La senal del GPS se debilita.
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 1206518888}
    - {fileID: 1432390385}
    - {fileID: 1680485464}
    - {fileID: 880479334}
    gpsSignal: 0.25
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 0
    checkpointSpawn: 
  - objective: Entra por la puerta del laboratorio
    completeOn: puerta-laboratorio
    lines:
    - Al fin. La puerta del laboratorio. Esta entreabierta.
    marker: {fileID: 1597617208}
    gpsRoute: []
    gpsSignal: 1
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: Fin del prologo
    checkpoint: 0
    checkpointSpawn: 
  gpsArrival: 3.5
