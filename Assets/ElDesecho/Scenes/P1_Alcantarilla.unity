    completeChapterTitle: 
    checkpoint: 1
    checkpointSpawn: escalera
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: camara
    count: 1
    lines:
    - Marcas recientes en el suelo... como si algo pesado hubiera sido arrastrado por aqui.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
