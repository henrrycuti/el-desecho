  steps:
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: marcas
    count: 1
    lines:
    - El GPS marca una ruta bajo las calles. Termina en una puerta de seguridad.
    - El agua le llega a los tobillos.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 651797635}
    - {fileID: 313629374}
    - {fileID: 962319101}
    - {fileID: 352387482}
    - {fileID: 1964521626}
    - {fileID: 976367205}
    - {fileID: 1640605683}
    - {fileID: 902473326}
    gpsSignal: 0.9
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 1
    checkpointSpawn: escalera
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: camara
    count: 1
    lines:
    - Marcas recientes en el suelo... como si algo pesado hubiera sido arrastrado por aqui.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
