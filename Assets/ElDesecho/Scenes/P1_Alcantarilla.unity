  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ElDesecho.ObjectiveManager
  steps:
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: marcas
    count: 1
    lines:
    - El GPS marca una ruta bajo las calles. Termina en una puerta de seguridad.
    - El agua le llega a los tobillos.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 56264234}
    - {fileID: 741713267}
    - {fileID: 1817244974}
    - {fileID: 50842831}
    - {fileID: 640761404}
    - {fileID: 1621360702}
    - {fileID: 1798344963}
    - {fileID: 1337808343}
    gpsSignal: 0.9
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 1
    checkpointSpawn: escalera
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: camara
    count: 1
    lines:
    - Marcas recientes en el suelo... como si algo pesado hubiera sido arrastrado por aqui.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 741713267}
    - {fileID: 1817244974}
    - {fileID: 50842831}
    - {fileID: 640761404}
    - {fileID: 1621360702}
    - {fileID: 1798344963}
    - {fileID: 1337808343}
    gpsSignal: 0.55
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 0
    checkpointSpawn: 
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: puerta-vista
    count: 1
    lines:
    - La senal del GPS se debilita.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 640761404}
    - {fileID: 1621360702}
    - {fileID: 1798344963}
    - {fileID: 1337808343}
    gpsSignal: 0.25
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 0
    checkpointSpawn: 
  - objective: Entra por la puerta del laboratorio
    completeOn: puerta-laboratorio
    count: 1
    lines:
    - Al fin. La puerta del laboratorio. Esta entreabierta.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 85485924}
    gpsRoute: []
    gpsSignal: 1
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: Fin del prologo
    checkpoint: 0
    checkpointSpawn: 
  gpsArrival: 3.5
