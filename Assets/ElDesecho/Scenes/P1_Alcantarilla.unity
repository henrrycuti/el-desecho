  steps:
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: marcas
    count: 1
    lines:
    - El GPS marca una ruta bajo las calles. Termina en una puerta de seguridad.
    - El agua le llega a los tobillos.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 1757891804}
    - {fileID: 1118575473}
    - {fileID: 1178820721}
    - {fileID: 2145507591}
    - {fileID: 1043504737}
    - {fileID: 1277761617}
    - {fileID: 691143992}
    - {fileID: 1862648563}
    gpsSignal: 0.9
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 1
    checkpointSpawn: escalera
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: camara
    count: 1
    lines:
    - Marcas recientes en el suelo... como si algo pesado hubiera sido arrastrado por aqui.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 1118575473}
