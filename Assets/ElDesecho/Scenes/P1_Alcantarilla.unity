    completeChapterTitle: 
    checkpoint: 0
    checkpointSpawn: 
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: puerta-vista
    count: 1
    lines:
    - La senal del GPS se debilita.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 1940192496}
    - {fileID: 1047248820}
    - {fileID: 199266519}
    - {fileID: 1446610465}
    gpsSignal: 0.25
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 0
