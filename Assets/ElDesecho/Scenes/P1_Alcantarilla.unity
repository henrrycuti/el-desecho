  steps:
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: marcas
    count: 1
    lines:
    - El GPS marca una ruta bajo las calles. Termina en una puerta de seguridad.
    - El agua le llega a los tobillos.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 72795245}
    - {fileID: 727942122}
    - {fileID: 462478253}
    - {fileID: 2062028778}
    - {fileID: 1906032674}
