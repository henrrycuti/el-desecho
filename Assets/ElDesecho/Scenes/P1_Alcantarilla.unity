  steps:
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: marcas
    count: 1
    lines:
    - El GPS marca una ruta bajo las calles. Termina en una puerta de seguridad.
    - El agua le llega a los tobillos.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 1371364717}
    - {fileID: 86674083}
    - {fileID: 1725900782}
    - {fileID: 1765174334}
    - {fileID: 1940192496}
    - {fileID: 1047248820}
    - {fileID: 199266519}
    - {fileID: 1446610465}
    gpsSignal: 0.9
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 1
    checkpointSpawn: escalera
  - objective: Sigue el GPS hasta la puerta de seguridad
    completeOn: camara
    count: 1
    lines:
    - Marcas recientes en el suelo... como si algo pesado hubiera sido arrastrado por aqui.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute:
    - {fileID: 86674083}
    - {fileID: 1725900782}
    - {fileID: 1765174334}
    - {fileID: 1940192496}
