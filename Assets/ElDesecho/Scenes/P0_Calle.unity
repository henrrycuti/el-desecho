  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8e377a532fa1954f885476f78f5389a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ElDesecho.ObjectiveManager
  steps:
  - objective: Encuentra la entrada de mantenimiento de la fotografia
    completeOn: callejon
    count: 1
    lines:
    - Un sobre sin remitente. Dentro, una direccion y una fotografia borrosa de una entrada de mantenimiento.
    - 'La nota decia: "Bajo la ciudad estan escondiendo algo. Si quieres saber la verdad, ve esta noche. No confies en nadie."'
    - En la foto se ve un letrero rojo al fondo de un callejon.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 0}
    gpsRoute: []
    gpsSignal: 1
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 0
    checkpointSpawn: 
  - objective: Abre la tapa de mantenimiento
    completeOn: tapa
    count: 1
    lines:
    - Es aqui. El mismo letrero de la fotografia.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 439934558}
    gpsRoute: []
    gpsSignal: 1
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 0
    checkpointSpawn: 
  - objective: Baja por la escalera
    completeOn: bajar
    count: 1
    lines:
    - Debajo hay una escalera oxidada que se pierde en la oscuridad.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 60250973}
    gpsRoute: []
    gpsSignal: 1
    loadScene: P1_Alcantarilla
    loadSpawn: escalera
    loadTitle: 'Prologo: La mision'
    completeChapterTitle: 
    checkpoint: 0
    checkpointSpawn: 
  gpsArrival: 3.5
