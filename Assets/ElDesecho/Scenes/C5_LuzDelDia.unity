MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 988721512}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8e377a532fa1954f885476f78f5389a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ElDesecho.ObjectiveManager
  steps:
  - objective: Gira el mecanismo de la puerta
    completeOn: puerta
    count: 1
    lines:
    - La llave encajaba en la cerradura. Tras la puerta, una corriente de aire frio. Mas alla estaba la salida.
    dialogue: 0
    raiseOnStart: 
    marker: {fileID: 811075517}
    gpsRoute: []
    gpsSignal: 1
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 1
    checkpointSpawn: puerta
  - objective: "\xA1Corre!"
    completeOn: tramo2
    count: 1
    lines:
    - Comenzo la ultima persecucion. Salta las zanjas (Espacio) y agachate bajo los cables (C).
    dialogue: 0
    raiseOnStart: tramo-1
    marker: {fileID: 0}
    gpsRoute: []
    gpsSignal: 1
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 1
    checkpointSpawn: puerta
  - objective: "\xA1Corre!"
    completeOn: tramo3
    count: 1
    lines:
    - Si una criatura te cierra el paso, usa el antidoto (Q).
    dialogue: 0
    raiseOnStart: tramo-2
    marker: {fileID: 0}
    gpsRoute: []
    gpsSignal: 1
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 1
    checkpointSpawn: tramo2
  - objective: "\xA1Corre!"
    completeOn: tramo4
    count: 1
    lines:
    - 'Adrenalina (R): recupera velocidad unos segundos. Solo tienes dos dosis.'
    dialogue: 0
    raiseOnStart: tramo-3
    marker: {fileID: 0}
    gpsRoute: []
    gpsSignal: 1
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: 
    checkpoint: 1
    checkpointSpawn: tramo3
  - objective: "\xA1Corre hacia la luz!"
    completeOn: final
    count: 1
    lines:
    - Al final del tunel aparecio una compuerta abierta.
    dialogue: 0
    raiseOnStart: tramo-4
    marker: {fileID: 89770520}
    gpsRoute: []
    gpsSignal: 1
    loadScene: 
    loadSpawn: 
    loadTitle: 
    completeChapterTitle: Fin del capitulo 5
    checkpoint: 1
    checkpointSpawn: tramo4
  gpsArrival: 3.5
